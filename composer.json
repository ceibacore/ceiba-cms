{
    "name": "ceibacore/ceiba-cms",
    "description": "Ceiba CMS - Framework-agnostic PHP 8.x CMS module",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ceibacore/ceiba-db": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "LemurCms\\": "src/"
        },
        "classmap": [
            "migrations/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "LemurCms\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}