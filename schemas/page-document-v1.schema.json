{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ceibacore.dev/schemas/page-document-v1.schema.json",
  "title": "Ceiba CMS page document envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "revision",
    "root",
    "settings",
    "resources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "root": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "settings": {
      "type": "object"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "props": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "array",
              "maxItems": 0
            }
          ]
        },
        "bindings": {
          "anyOf": [
            {
              "type": [
                "object",
                "null"
              ]
            },
            {
              "type": "array",
              "maxItems": 0
            }
          ]
        },
        "loop": {
          "anyOf": [
            {
              "type": [
                "object",
                "null"
              ]
            },
            {
              "type": "array",
              "maxItems": 0
            }
          ]
        },
        "condition": {},
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
